{
  "type": "monitor",
  "monitor_type": "bucket_level_monitor",
  "name": "siemlab: content discovery (10 sensitive-path probes from one source in 1 minute)",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 1,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "wazuh-findings-v5-*"
        ],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                {
                  "range": {
                    "@timestamp": {
                      "gte": "{{period_end}}||-1m",
                      "lte": "{{period_end}}",
                      "format": "epoch_millis"
                    }
                  }
                },
                {
                  "term": {
                    "wazuh.rule.tags": "lab.web_sensitive_probe"
                  }
                }
              ]
            }
          },
          "aggregations": {
            "composite_agg": {
              "composite": {
                "sources": [
                  {
                    "source_ip": {
                      "terms": {
                        "field": "source.ip"
                      }
                    }
                  }
                ]
              },
              "aggs": {
                "events": {
                  "cardinality": {
                    "field": "wazuh.event.id"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "bucket_level_trigger": {
        "name": "10+ sensitive-path probes from one source",
        "severity": "3",
        "condition": {
          "buckets_path": {
            "events": "events"
          },
          "parent_bucket_path": "composite_agg",
          "script": {
            "source": "params.events >= 10",
            "lang": "painless"
          }
        },
        "actions": []
      }
    }
  ]
}
