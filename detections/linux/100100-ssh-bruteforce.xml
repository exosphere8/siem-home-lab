<!--
  Project 2: Linux SSH brute-force detection          Rule IDs 100100-100199
  =====================================================================
  Source:  /var/log/auth.log on ubuntu-endpoint (sshd), via the Wazuh agent.
  Deploy:  scripts/deploy/deploy-rules.sh on wazuh-server (copies, validates, restarts).
  Test:    docs/projects/02-ssh-bruteforce.md (wazuh-logtest samples).
  Status:  Every rule passes logtest and analysis-queue cases on a real 4.14.8 manager in CI;
           live lab validation pending.

  How the rules chain:
    100100  re-labels every failed sshd login (any built-in "authentication_failed" rule)
            with our ID and ATT&CK mapping;
    100103  any failed login as root is notable on its own (root SSH should be disabled);
    100101  6+ failed logins (ending as 100100) from one source within 2 minutes;
    100107  6+ failed root logins (ending as 100103) from one source within 2 minutes;
    100102  that same source then logs in successfully within 10 minutes: the guessing worked.

  Why two counters instead of one rule counting the shared group ssh_failed_login: on a real
  manager, if_matched_group counted every failure several times, because 100100 hangs off
  many built-in sshd rules and each copy feeds the group's list. The "6 failures" rule fired
  on the 2nd. if_matched_sid keeps one list per rule, so the count is exact (CI logtest and
  analysis-queue cases). In a mixed attack, a root failure still passes 100100 on its way
  to 100103, so it can be the 6th count of 100101, but only non-root failures are stored
  there: ten alternating failures fire 100101 on the 10th. siemlab correlate counts all
  failures together. 100102 follows the group ssh_brute_force: it needs only one
  earlier match, so duplicates cannot change it. Rules that count or follow other rules are
  defined after them: links are made at load time.
-->
<group name="local,syslog,sshd,">

  <rule id="100100" level="5">
    <if_group>authentication_failed</if_group>
    <decoded_as>sshd</decoded_as>
    <description>SSH: failed login for '$(dstuser)' from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,ssh_failed_login,</group>
  </rule>

  <rule id="100103" level="8">
    <if_sid>100100</if_sid>
    <user>^root$</user>
    <description>SSH: failed login as root from $(srcip)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,ssh_failed_login,</group>
  </rule>

  <rule id="100101" level="10" frequency="6" timeframe="120" ignore="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>SSH: brute force from $(srcip): 6+ failed logins within 2 minutes</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,attack,ssh_brute_force,</group>
  </rule>

  <rule id="100107" level="10" frequency="6" timeframe="120" ignore="60">
    <if_matched_sid>100103</if_matched_sid>
    <same_source_ip />
    <description>SSH: brute force on root from $(srcip): 6+ failed root logins within 2 minutes</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,attack,ssh_brute_force,</group>
  </rule>

  <rule id="100102" level="13" timeframe="600">
    <if_group>authentication_success</if_group>
    <if_matched_group>ssh_brute_force</if_matched_group>
    <same_source_ip />
    <description>SSH: login as '$(dstuser)' from $(srcip) after a brute force: possible account compromise</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,attack,</group>
  </rule>

</group>
