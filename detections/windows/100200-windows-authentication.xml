<!--
  Project 3: Windows authentication monitoring         Rule IDs 100200-100299
  =====================================================================
  Source:  Windows Security event log on win11-endpoint (eventchannel), via the Wazuh agent.
           Requires the audit policy in docs/setup-guides/04-windows-agent.md.
  Deploy:  scripts/deploy/deploy-rules.sh on wazuh-server.
  Test:    docs/projects/03-windows-authentication.md
  Status:  Written; pending validation in the lab.

  Event IDs: 4625 failed logon, 4740 account locked out, 4624 successful logon (type 10 = RDP),
             4720 user account created, 4732 member added to a security-enabled local group
             (S-1-5-32-544 is the built-in Administrators group), 1102 audit log cleared.
           1102 records who cleared the log under UserData/LogFileCleared, not EventData,
           so 100206 names the computer; the subject is in the alert's full event data.
-->
<group name="local,windows,windows_security,">

  <rule id="100200" level="5">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4625$</field>
    <description>Windows: failed logon for '$(win.eventdata.targetUserName)' from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100201" level="10" frequency="8" timeframe="120" ignore="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Windows: password guessing from $(win.eventdata.ipAddress): 8+ failed logons within 2 minutes</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,attack,</group>
  </rule>

  <rule id="100202" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4740$</field>
    <description>Windows: account '$(win.eventdata.targetUserName)' locked out</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100203" level="6">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^10$</field>
    <description>Windows: RDP logon as '$(win.eventdata.targetUserName)' from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1021.001</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="100204" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4720$</field>
    <description>Windows: local account '$(win.eventdata.targetUserName)' created by '$(win.eventdata.subjectUserName)'</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>account_changed,</group>
  </rule>

  <rule id="100205" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4732$</field>
    <field name="win.eventdata.targetSid">^S-1-5-32-544$</field>
    <description>Windows: account added to the local Administrators group by '$(win.eventdata.subjectUserName)'</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>account_changed,attack,</group>
  </rule>

  <rule id="100206" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1102$</field>
    <description>Windows: Security audit log cleared on $(win.system.computer)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>attack,</group>
  </rule>

</group>
